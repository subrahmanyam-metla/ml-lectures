        function initViewportZoomSupport() {
            const frame = document.getElementById('viewport-content-frame');
            if (!frame) return;

            frame.addEventListener('wheel', (e) => {
                e.preventDefault();
                const zoomIntensity = 0.08;
                if (e.deltaY < 0) {
                    adjustZoom(zoomIntensity);
                } else {
                    adjustZoom(-zoomIntensity);
                }
            }, { passive: false });

            // Pinch to zoom touch configurations
            let touchStartDist = 0;
            frame.addEventListener('touchstart', (e) => {
                if (e.touches.length === 2) {
                    touchStartDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                }
            }, { passive: true });

            frame.addEventListener('touchmove', (e) => {
                if (e.touches.length === 2 && touchStartDist > 0) {
                    const currentDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                    const diff = currentDist - touchStartDist;
                    const scaleFactor = diff * 0.005;
                    adjustZoom(scaleFactor);
                    touchStartDist = currentDist;
                }
            }, { passive: true });

            frame.addEventListener('touchend', () => {
                touchStartDist = 0;
            });
        }

