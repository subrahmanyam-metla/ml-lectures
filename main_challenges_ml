        function updateTradeoffCurves() {
            const complexity = parseFloat(document.getElementById('slider-complexity').value);
            document.getElementById('complexity-val').innerText = complexity.toFixed(1);

            const bias = Math.pow(10 - complexity, 2) / 10 + 1;
            const variance = Math.pow(complexity, 2) / 10 + 0.5;
            const totalError = bias + variance;

            document.getElementById('val-bias').innerText = bias.toFixed(2);
            document.getElementById('val-variance').innerText = variance.toFixed(2);
            document.getElementById('val-total-error').innerText = totalError.toFixed(2);

            const svg = document.getElementById('tradeoff-svg');
            if (!svg) return;

            let pathBias = "M 20 100 ";
            let pathVar = "M 20 100 ";
            let pathTot = "M 20 100 ";

            for (let i = 0; i <= 20; i++) {
                const xVal = 1 + (i / 20) * 9;
                const tempBias = Math.pow(10 - xVal, 2) / 10 + 1;
                const tempVar = Math.pow(xVal, 2) / 10 + 0.5;
                const tempTot = tempBias + tempVar;

                const screenX = 20 + (i / 20) * 260;
                const screenBiasY = 110 - (tempBias / 12) * 80;
                const screenVarY = 110 - (tempVar / 12) * 80;
                const screenTotY = 110 - (tempTot / 12) * 80;

                pathBias += `L ${screenX} ${screenBiasY} `;
                pathVar += `L ${screenX} ${screenVarY} `;
                pathTot += `L ${screenX} ${screenTotY} `;
            }

            const currentX = 20 + ((complexity - 1) / 9) * 260;
            const currentY = 110 - (totalError / 12) * 80;

            svg.innerHTML = `
                <line x1="20" y1="110" x2="280" y2="110" stroke="#cbd5e1" stroke-width="2" />
                <line x1="20" y1="10" x2="20" y2="110" stroke="#cbd5e1" stroke-width="2" />
                
                <path d="${pathBias}" fill="none" stroke="#ef4444" stroke-width="2" opacity="0.6"/>
                <path d="${pathVar}" fill="none" stroke="#3b82f6" stroke-width="2" opacity="0.6"/>
                <path d="${pathTot}" fill="none" stroke="#10b981" stroke-width="3" />
                
                <circle cx="${currentX}" cy="${currentY}" r="5" fill="#1e3a8a" class="pulse-element" />
                <text x="280" y="118" fill="#475569" font-size="7" font-family="monospace" text-anchor="end">Complexity</text>
                <text x="15" y="15" fill="#475569" font-size="7" font-family="monospace">Error Rate</text>
            `;
        }

