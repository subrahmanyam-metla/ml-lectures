                    isPanning = true;
                    startPanCoords = { x: e.clientX - panOffset.x, y: e.clientY - panOffset.y };
                    frame.style.cursor = 'grabbing';
                    e.preventDefault();
                }
            });

            frame.addEventListener('mousemove', (e) => {
                if (isPanning) {
                    panOffset.x = e.clientX - startPanCoords.x;
                    panOffset.y = e.clientY - startPanCoords.y;
                    applyZoomTransform();
                }
            });

            window.addEventListener('mouseup', () => {
                if (isPanning) {
                    isPanning = false;
                    if (frame) frame.style.cursor = '';
                }
            });

            // Touch bindings
            frame.addEventListener('touchstart', (e) => {
                if ((panModeActive || e.touches.length > 1) && e.touches.length === 1) {
                    isPanning = true;
                    startPanCoords = { x: e.touches[0].clientX - panOffset.x, y: e.touches[0].clientY - panOffset.y };
                }
            });

            frame.addEventListener('touchmove', (e) => {
                if (isPanning && e.touches.length === 1) {
                    panOffset.x = e.touches[0].clientX - startPanCoords.x;
                    panOffset.y = e.touches[0].clientY - startPanCoords.y;
                    applyZoomTransform();
                }
            });

            frame.addEventListener('touchend', () => {
                isPanning = false;
            });
        }

