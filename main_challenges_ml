            document.getElementById('btn-sb-linear').className = "flex-1 py-2 rounded-lg text-xs font-bold border border-slate-300 bg-white text-slate-700 shadow-sm";
            document.getElementById('btn-sb-quad').className = "flex-1 py-2 rounded-lg text-xs font-bold border border-slate-300 bg-white text-slate-700 shadow-sm";
            document.getElementById('btn-sb-overfit').className = "flex-1 py-2 rounded-lg text-xs font-bold border border-orange-200 bg-orange-50 text-brand-500 shadow-sm";

            if (modelType === 'linear') {
                document.getElementById('btn-sb-linear').className = "flex-1 py-2 rounded-lg text-xs font-bold border border-orange-200 bg-orange-50 text-brand-500 shadow-sm";
            } else if (modelType === 'quadratic') {
                document.getElementById('btn-sb-quad').className = "flex-1 py-2 rounded-lg text-xs font-bold border border-orange-200 bg-orange-50 text-brand-500 shadow-sm";
            } else if (modelType === 'overfit') {
                document.getElementById('btn-sb-overfit').className = "flex-1 py-2 rounded-lg text-xs font-bold border border-orange-200 bg-orange-50 text-brand-500 shadow-sm";
            }

            drawSandboxPlot();
        }

        function clearSandboxPoints() {
            sandboxPoints = [];
            drawSandboxPlot();
        }

        function drawSandboxPlot() {
            const canvas = document.getElementById('sandbox-plot-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, w, h);

            if (sandboxPoints.length > 1) {
                // draw fit lines based on model selection
                ctx.lineWidth = 3;
                if (sandboxModelType === 'linear') {
                    ctx.strokeStyle = '#1e3a8a';
                    ctx.beginPath();
                    ctx.moveTo(0, h * 0.75);
                    ctx.lineTo(w, h * 0.25);
                    ctx.stroke();
                } else if (sandboxModelType === 'quadratic') {
                    ctx.strokeStyle = '#059669';
                    ctx.beginPath();
                    for (let x = 0; x < w; x++) {
                        const normalizedX = (x / w) - 0.5;
                        const y = h * 0.6 - (normalizedX * normalizedX * h * 1.2);
                        if (x === 0) ctx.moveTo(x, y);
                        else ctx.lineTo(x, y);
                    }
                    ctx.stroke();
                } else {
                    ctx.strokeStyle = '#ea580c';
                    ctx.beginPath();
                    for (let x = 0; x < w; x++) {
                        const y = h * 0.5 + Math.sin(x * 0.04) * 50 + Math.cos(x * 0.015) * 30;
                        if (x === 0) ctx.moveTo(x, y);
                        else ctx.lineTo(x, y);
                    }
                    ctx.stroke();
                }
            }

            // Draw points
            sandboxPoints.forEach(pt => {
                ctx.fillStyle = pt.label === 1 ? '#059669' : '#ef4444';
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 6, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 1.5;
                ctx.stroke();
            });
        }

        function updateBoundPlot() {
            const n = parseFloat(document.getElementById('sb-slider-n').value);
            const eps = parseFloat(document.getElementById('sb-slider-eps').value);
            const m = parseFloat(document.getElementById('sb-slider-m').value);

            document.getElementById('sb-slider-n-val').innerText = n;
            document.getElementById('sb-slider-eps-val').innerText = eps.toFixed(2);
            document.getElementById('sb-slider-m-val').innerText = m;

            const exponent = -2 * (eps * eps) * n;
            const boundVal = 2 * m * Math.exp(exponent);

            document.getElementById('sb-calculated-prob').innerText = boundVal > 1 ? "1.000000" : boundVal.toFixed(6);

            const svg = document.getElementById('bound-curve-svg');
            if (!svg) return;

            let pathD = "M 20 100 ";
            for (let i = 0; i <= 20; i++) {
                const sampleScale = (i / 20) * 10000;
                const tempExp = -2 * (eps * eps) * sampleScale;
                const tempBound = 2 * m * Math.exp(tempExp);
                const screenY = 100 - (Math.min(tempBound, 2) / 2) * 80;
                const screenX = 20 + (i / 20) * 260;
                pathD += `L ${screenX} ${screenY} `;
            }

            const currentExp = -2 * (eps * eps) * n;
            const currentBoundValue = 2 * m * Math.exp(currentExp);
            const targetX = 20 + (n / 10000) * 260;
            const targetY = 100 - (Math.min(currentBoundValue, 2) / 2) * 80;

            svg.innerHTML = `
                <line x1="20" y1="100" x2="280" y2="100" stroke="#cbd5e1" stroke-width="2" />
                <line x1="20" y1="20" x2="20" y2="100" stroke="#cbd5e1" stroke-width="2" />
                <path d="${pathD}" fill="none" stroke="#ea580c" stroke-width="3" />
                <circle cx="${targetX}" cy="${targetY}" r="5" fill="#1e3a8a" class="pulse-element" />
                <text x="280" y="115" fill="#475569" font-size="8" font-family="monospace" text-anchor="end">N Samples</text>
                <text x="15" y="15" fill="#475569" font-size="8" font-family="monospace">Probability Bound</text>
            `;
        }

        document.addEventListener('keydown', (e) => {
            const activeTag = document.activeElement.tagName.toLowerCase();
            if (activeTag === 'input' || activeTag === 'textarea') return;

            switch (e.key) {
                case 'ArrowRight':
                case ' ':
                    e.preventDefault();
                    nextSlide();
                    break;
                case 'ArrowLeft':
                    e.preventDefault();
                    prevSlide();
                    break;
                case 'f':
                case 'F':
                    e.preventDefault();
                    toggleFullscreen();
                    break;
                case 'o':
                case 'O':
                    e.preventDefault();
                    toggleSidebar();
                    break;
                case 'n':
                case 'N':
                    e.preventDefault();
                    toggleNotesSidebar();
                    break;
                case 'w':
                case 'W':
                    e.preventDefault();
                    toggleWhitepaperMode();
                    break;
                case 'm':
                case 'M':
                    e.preventDefault();
                    toggleMode(lectureMode === 'student' ? 'teacher' : 'student');
                    break;
                case 'Escape':
                    const modal = document.getElementById('help-modal');
                    if (!modal.classList.contains('hidden')) modal.classList.add('hidden');
                    break;
            }
        });

        document.addEventListener('fullscreenchange', () => {
            const icon = document.getElementById('fullscreen-icon');
            if (document.fullscreenElement) {
                icon.className = "fa-solid fa-compress";
            } else {
                if (!isPseudoFullscreen) {
                    icon.className = "fa-solid fa-expand";
                }
            }
            setTimeout(resizeWhiteboardCanvas, 150);
        });

        window.onload = function () {
            initSidebarOutline();
            renderCurrentSlide();
            initWhiteboard();
            initLaserPointer();
            initViewportPan();
            initViewportZoomSupport();

            // Sidebar simulation engines
            initSandboxPlotter();
            updateBoundPlot();
        }
    </script>
</body>

</html>
